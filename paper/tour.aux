\@writefile{toc}{\contentsline {section}{\numberline {6}Results I: the honest scoreboard}{7}{section.6}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces The full scoreboard at the binding budget. Connectivity misses of $\approx 0.4$ per run appear in \emph  {every} arm including the full graph: those are cycles where the live network itself cannot reach a required node --- nobody can fix those. Trust metrics: Spearman $0.295$ (QUBO, best) vs $0.251$--$0.271$; AUC $0.681$ vs $0.624$--$0.683$.}}{7}{table.caption.9}\protected@file@percent }
\newlabel{tab:scoreboard}{{3}{7}{The full scoreboard at the binding budget. Connectivity misses of $\approx 0.4$ per run appear in \emph {every} arm including the full graph: those are cycles where the live network itself cannot reach a required node --- nobody can fix those. Trust metrics: Spearman $0.295$ (QUBO, best) vs $0.251$--$0.271$; AUC $0.681$ vs $0.624$--$0.683$}{table.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Top: the nominal-budget benchmark (budget infeasible --- every arm's budget ``violations'' here reflect the infeasible $K{=}15$, and the QUBO's ladder relaxes it silently). Bottom: the binding-budget benchmark, where the QUBO is fully constrained and the guarantees are real. Success (left) and violations (right), 16 seeds $\times $ 20 cycles.}}{8}{figure.caption.8}\protected@file@percent }
\newlabel{fig:bench}{{5}{8}{Top: the nominal-budget benchmark (budget infeasible --- every arm's budget ``violations'' here reflect the infeasible $K{=}15$, and the QUBO's ladder relaxes it silently). Bottom: the binding-budget benchmark, where the QUBO is fully constrained and the guarantees are real. Success (left) and violations (right), 16 seeds $\times $ 20 cycles}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}Reading the scoreboard like a reviewer}{8}{subsection.6.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces The three delivery metrics side by side (binding budget): the top-$K$ arms trade stranded tasks (offload 89.8\%) for strong paths (delivery-fail 30.9\%); the QUBO is the mirror image. The repaired baselines sit in between on both.}}{9}{figure.caption.10}\protected@file@percent }
\newlabel{fig:delivery}{{6}{9}{The three delivery metrics side by side (binding budget): the top-$K$ arms trade stranded tasks (offload 89.8\%) for strong paths (delivery-fail 30.9\%); the QUBO is the mirror image. The repaired baselines sit in between on both}{figure.caption.10}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7}Results II: the constraint-pressure sweep --- does the guarantee ever pay?}{9}{section.7}\protected@file@percent }
\newlabel{sec:pressure}{{7}{9}{Results II: the constraint-pressure sweep --- does the guarantee ever pay?}{section.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Budget pressure. Left: success. Right: budget violations per run --- the blind threshold pruner violates the budget in 20 of 20 cycles at $\beta {=}0.35$ and still $12.8$ of 20 at $\beta {=}0.75$, while the QUBO converges to zero (its small residual at $\beta \le 0.5$ is the ladder relaxing a genuinely infeasible request, which the bookkeeping counts and reports).}}{10}{figure.caption.11}\protected@file@percent }
\newlabel{fig:budgetsweep}{{7}{10}{Budget pressure. Left: success. Right: budget violations per run --- the blind threshold pruner violates the budget in 20 of 20 cycles at $\beta {=}0.35$ and still $12.8$ of 20 at $\beta {=}0.75$, while the QUBO converges to zero (its small residual at $\beta \le 0.5$ is the ladder relaxing a genuinely infeasible request, which the bookkeeping counts and reports)}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Degree and roster pressure: same story --- the QUBO's deficit narrows as the constraint loosens, never reverses.}}{10}{figure.caption.12}\protected@file@percent }
