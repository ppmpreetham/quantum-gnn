<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="rover">
    <link name="base_link">
      <pose>0 0 0.20 0 0 0</pose>
      <inertial><mass>3.0</mass><inertia><ixx>0.2</ixx><iyy>0.2</iyy><izz>0.3</izz></inertia></inertial>
      <collision name="collision">
        <geometry><box><size>0.9 0.65 0.25</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.9 0.65 0.25</size></box></geometry>
        <material><ambient>0.12 0.42 0.72 1</ambient><diffuse>0.16 0.52 0.90 1</diffuse></material>
      </visual>
    </link>

    <link name="left_wheel">
      <pose>0 0.38 0.12 1.5708 0 0</pose>
      <inertial><mass>0.25</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.16</radius><length>0.08</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.16</radius><length>0.08</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material></visual>
    </link>
    <link name="right_wheel">
      <pose>0 -0.38 0.12 1.5708 0 0</pose>
      <inertial><mass>0.25</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.16</radius><length>0.08</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.16</radius><length>0.08</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material></visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.76</wheel_separation>
      <wheel_radius>0.16</wheel_radius>
      <!-- no fixed topics: each rover gets /model/<name>/cmd_vel and /model/<name>/odometry -->
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
